---
import '../styles/admin.css';
import { SITE } from '../config';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/admin', label: '文章管理', match: (p: string) => p === '/admin' || /^\/admin\/posts\/(?!new)/.test(p) },
  { href: '/admin/posts/new', label: '新增文章', match: (p: string) => p === '/admin/posts/new' },
  { href: '/admin/messages', label: '聯絡訊息', match: (p: string) => p.startsWith('/admin/messages') },
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}｜{SITE.shortName}後台</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <a href="/admin" class="logo"><span>鋒</span>{SITE.shortName}後台</a>
        <nav>
          {links.map((l) => <a href={l.href} class:list={{ on: l.match(path) }}>{l.label}</a>)}
        </nav>
        <div class="side-foot">
          <a href="/" target="_blank" rel="noopener">查看網站 ↗</a>
          <form method="post" action="/admin/logout"><button type="submit">登出</button></form>
        </div>
      </aside>
      <main class="main">
        <slot />
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 100vh;
  }
  .side {
    background: var(--a-navy);
    color: #c6d0da;
    padding: 24px 16px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0 8px 24px;
  }
  .logo span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--a-gold);
    color: var(--a-gold);
  }
  nav {
    display: grid;
    gap: 4px;
  }
  nav a {
    padding: 10px 12px;
    border-radius: 6px;
    text-decoration: none;
  }
  nav a:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  nav a.on {
    background: rgba(201, 164, 92, 0.16);
    color: #fff;
  }
  .side-foot {
    margin-top: auto;
    display: grid;
    gap: 8px;
    padding: 0 12px;
    font-size: 14px;
  }
  .side-foot a {
    text-decoration: none;
  }
  .side-foot button {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .side-foot a:hover,
  .side-foot button:hover {
    color: var(--a-gold);
  }
  .main {
    padding: 32px clamp(16px, 3vw, 40px) 64px;
    min-width: 0;
  }
  @media (max-width: 760px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      height: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 16px;
      padding: 12px 16px;
    }
    .logo {
      padding: 0;
    }
    nav {
      display: flex;
      flex-wrap: wrap;
    }
    .side-foot {
      margin: 0;
      display: flex;
      gap: 16px;
      padding: 0;
    }
  }
</style>
