---
import { NAV, SITE } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={SITE.name}>
      <span class="mark">鋒</span>
      <span class="names">
        <strong>{SITE.name}</strong>
        <small>{SITE.nameEn}</small>
      </span>
    </a>
    <button class="menu-btn" aria-label="開啟選單" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="nav">
      {NAV.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
      ))}
      <a href="/contact" class="btn btn--gold nav-cta">預約諮詢</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 26, 40, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(201, 164, 92, 0.2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #fff;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--gold-500);
    color: var(--gold-500);
    font-family: var(--serif);
    font-size: 22px;
  }
  .names {
    display: grid;
    line-height: 1.3;
  }
  .names strong {
    font-family: var(--serif);
    font-size: 19px;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .names small {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: #8fa1b2;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }
  .nav a:not(.btn) {
    color: #c6d0da;
    text-decoration: none;
    font-size: 15px;
    letter-spacing: 0.12em;
    position: relative;
    padding: 6px 0;
  }
  .nav a:not(.btn):hover,
  .nav a.active {
    color: #fff;
  }
  .nav a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--gold-500);
  }
  .nav-cta {
    padding: 10px 22px;
  }
  .menu-btn {
    display: none;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 24px;
    height: 1.5px;
    background: #fff;
    margin: 6px 0;
    transition: transform 0.2s, opacity 0.2s;
  }
  @media (max-width: 900px) {
    .menu-btn {
      display: block;
    }
    .nav {
      position: fixed;
      inset: 76px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px 24px 28px;
      background: var(--navy-900);
      border-bottom: 1px solid rgba(201, 164, 92, 0.2);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s;
    }
    :global(body.nav-open) .nav {
      transform: none;
      opacity: 1;
      visibility: visible;
    }
    .nav a:not(.btn) {
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .nav a.active::after {
      display: none;
    }
    .nav-cta {
      margin-top: 20px;
    }
    :global(body.nav-open) .menu-btn span:nth-child(1) {
      transform: translateY(7.5px) rotate(45deg);
    }
    :global(body.nav-open) .menu-btn span:nth-child(2) {
      opacity: 0;
    }
    :global(body.nav-open) .menu-btn span:nth-child(3) {
      transform: translateY(-7.5px) rotate(-45deg);
    }
  }
  @media (max-width: 420px) {
    .names small {
      display: none;
    }
  }
</style>
