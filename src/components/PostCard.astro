---
import type { Post } from '../lib/db';
import { formatDate } from '../lib/format';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<article class="card">
  <a href={`/insights/${post.slug}`} class="cover" tabindex="-1" aria-hidden="true">
    {post.cover ? <img src={post.cover} alt="" loading="lazy" /> : <span class="placeholder">{post.category}</span>}
  </a>
  <div class="body">
    <p class="meta"><span>{post.category}</span><time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time></p>
    <h3><a href={`/insights/${post.slug}`}>{post.title}</a></h3>
    <p class="excerpt">{post.excerpt}</p>
  </div>
</article>

<style>
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy-800);
    display: block;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--gold-500);
    font-family: var(--serif);
    font-size: 20px;
    letter-spacing: 0.3em;
    background: radial-gradient(ellipse at 70% 20%, rgba(201, 164, 92, 0.22), transparent 60%);
  }
  .body {
    padding: 24px 26px 28px;
  }
  .meta {
    display: flex;
    gap: 14px;
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .meta span {
    color: var(--gold-500);
    letter-spacing: 0.1em;
  }
  h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--navy-500);
  }
  .excerpt {
    color: var(--ink-soft);
    font-size: 14.5px;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
