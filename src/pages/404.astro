---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---

<Base title="找不到頁面">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>找不到這個頁面</h1>
      <p>您要找的頁面可能已移除或網址有誤。</p>
      <p style="margin-top:32px"><a href="/" class="btn btn--gold">回到首頁</a></p>
    </div>
  </section>
</Base>
