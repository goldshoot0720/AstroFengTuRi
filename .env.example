# 後台登入密碼（請務必修改）
ADMIN_PASSWORD=change-me-please
# 用於簽署登入 Cookie 的隨機字串，可用 `openssl rand -hex 32` 產生
SESSION_SECRET=replace-with-a-long-random-string
# 設定後改用 Vercel Blob 儲存資料（在 Vercel 連結 Blob Store 會自動加入）
# BLOB_READ_WRITE_TOKEN=
# 未使用 Blob 時的本機資料目錄（文章 JSON、上傳圖片），預設為 ./data
DATA_DIR=./data
# 網站正式網址
SITE_URL=https://www.example.com
